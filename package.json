{
  "name": "tamy-iptv",
  "version": "1.0.0",
  "description": "TAMY IPTV - مشغّل IPTV (M3U / Xtream) مع راديو ومواقيت الصلاة",
  "private": true,
  "scripts": {
    "prepare:www": "node scripts/prepare-www.js",
    "serve": "npx http-server www -p 8080 -c-1",
